# Licensed or restricted data never goes in the repo. See README for how to get it.
Raw_Data/fdi_private/*
!Raw_Data/fdi_private/README.md
Raw_Data/ipums/*
!Raw_Data/ipums/README.md

# Generated datasets are rebuilt by Syntax/0_master.do
Generated_Datasets/*
!Generated_Datasets/.gitkeep

# Batch-mode Stata logs land in the folder you run from
/*.log
*.smcl

# LaTeX build files (paper.pdf and online_appendix.pdf are committed)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# Local scratch
.raw_orig/
.DS_Store
