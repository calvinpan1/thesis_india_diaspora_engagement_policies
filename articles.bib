}

@article{qiao_returnees_2024,
	title = {Returnees and innovation: evidence from {Chinese} publicly listed firms},
	volume = {51},
	issn = {0302-3427},
	shorttitle = {Returnees and innovation},
	url = {https://doi.org/10.1093/scipol/scae031},
	doi = {10.1093/scipol/scae031},
	abstract = {As the Chinese economy shifts from factor-driven to innovation-driven growth, Chinese firms are increasingly lacking highly skilled talents. In this context, attracting high-skill returnees might represent an effective strategy to access knowledge. In this paper, we investigate the relationship between high-skill returnees and innovation of Chinese publicly listed firms. We construct a unique dataset of 2,499 firms over the period 2002–16 by combining three different data sources (i.e. Chinese Research Data Services Platform, China Stock Market \&amp; Accounting Research Database, and LinkedIn). Our results show that different typologies of returnees (employees, technologists, and managers) with different experiences abroad (work vs study) may bring back different skills and impact differently on firm innovation. Our main findings show that (1) returnee employees and technologists are positively associated with firm’s patenting; (2) returnees’ overseas work experience matters more than study experience; and (3) the positive role of returnees is subject to contingencies related to firm characteristics such as ownership, location, and size.},
	number = {5},
	urldate = {2026-04-05},
	journal = {Science and Public Policy},
	author = {Qiao, Yibo and Ascani, Andrea and Breschi, Stefano and Morrison, Andrea},
	month = oct,
	year = {2024},
	pages = {861--878},
}

