.         // FRED EXINUS (Feb 2026) = 90.7458 INR per USD. FRED GDPDEF annual m
> eans:
.         // 2023 = 122.38175, latest full year (2025) = 128.96375.
.         local usd_m_per_crore = (10000000 / 90.7458) / 1000000 * (128.96375 /
>  122.38175)

.         gen double budget_usd_m = budget_cr * `usd_m_per_crore'
