. ********
. *
. *       1. Program that builds one sample
. *
. ********
. 
.         // keepif:      who counts as diaspora in this sample
.         // natif:       who counts toward the "national Indian diaspora" in e
> ach metro
.         //                      (only used by the H0 tables, Tables 7.1 and 7
> .12)
.         // Andhra Pradesh (Telugu) is dropped for 2014-2017 everywhere becaus
> e the
.         // state split in two in 2014.
. 
.         capture program drop build_sample

.         program define build_sample
  1.                 syntax , NAME(string) KEEPIF(string) NATIF(string)
  2. 
.                 use "${gendata}/1_1_acs_india_microdata.dta", clear
  3.                 gen byte ap_split = languaged == 4003 & inrange(year, 2014
> , 2017)
  4. 
.                 **National Indian diaspora per metro-year
. 
.                         preserve
  5.                                 keep if `natif'
  6.                                 collapse (sum) total_indian_diaspora_pop =
>  perwt, by(year met2013)
  7.                                 tempfile nat_total
  8.                                 save `nat_total'
  9.                         restore
 10. 
.                 **Diaspora per metro x language x year
. 
.                         keep if `keepif' & !ap_split
 11.                         collapse (sum) n_people = perwt, by(year state met
> 2013 languaged)
 12.                         merge m:1 year met2013 using `nat_total', nogen ke
> ep(match master)
 13. 
.                 **Rank each language's metros by total diaspora over 2005-201
> 7
. 
.                         preserve
 14.                                 collapse (sum) total_n_people = n_people, 
> by(languaged met2013)
 15.                                 gsort languaged -total_n_people met2013
 16.                                 by languaged: gen metro_rank = _n
 17.                                 keep languaged met2013 metro_rank
 18.                                 tempfile ranks
 19.                                 save `ranks'
 20.                         restore
 21.                         merge m:1 languaged met2013 using `ranks', nogen
 22. 
.                 order year state met2013 languaged n_people total_indian_dias
> pora_pop metro_rank
 23.                 compress
 24.                 save "${gendata}/2_1_`name'.dta", replace
 25.         end

. 
