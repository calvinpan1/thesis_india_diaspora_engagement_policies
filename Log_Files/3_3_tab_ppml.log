. ********
. *
. *       2. Programs that prep data and run each kind of model
. *
. ********
. 
.         **Load a sample and build the regressors
. 
.                 capture program drop prep_panel

.                 program define prep_panel
  1.                         syntax , FILE(string) [TECHHUBS]
  2. 
.                         use "${gendata}/2_4_`file'.dta", clear
  3. 
.                         // Tech-hub check (Tables A23-A24): metros where big 
> tech firms are
.                         // headquartered, see Online Appendix Table A26
.                         if "`techhubs'" != "" {
  4.                                 keep if inlist(met2013, 42660, 41940, 4186
> 0, 38900, 14260, 38060, 41740) ///
>                                         | inlist(met2013, 12420, 39340, 41620
> , 31540, 22220, 39580, 20500)
  5.                         }
  6. 
.                         // No DEP row means no DEPs (leaves total_indian_dias
> pora_pop alone)
.                         foreach v of varlist total_deps total_non_econ total_
> econ total_symbolic ///
>                                 total_religious_cultural total_citizenship to
> tal_state_bureaucracy ///
>                                 total_abroad total_networks total_info total_
> advantages ${ALL_POLICIES} {
  7.                                 replace `v' = 0 if missing(`v')
  8.                         }
  9. 
.                         gen origin_id = met2013
 10.                         egen od_id = group(origin_id languaged)         //
>  metro x state pair
 11.                         gen ln_dias = ln(1 + n_people)
 12.                         gen ln_total_indian_dias = ln(1 + total_indian_dia
> spora_pop)
 13. 
.                         // Table 2: any DEP at all. Table 3: count of support
> ed DEPs.
.                         gen byte any_dep = total_deps > 0
 14.                         egen double sc_dep_count = rowtotal(${ELIGIBLE_POL
> ICIES})
 15. 
.                         // Table 4: count of supported DEPs in each category
.                         foreach c of global H4_CATEGORIES {
 16.                                 egen double sc_`c' = rowtotal(${MEMBERS_`c
> '})
 17.                         }
 18.                 end

. 
.         **Record the sample-size details shown under every table
. 
.                 capture program drop post_accounting

.                 program define post_accounting
  1.                         syntax , OUTCOME(name) RHS(varlist) TABLE(string) 
> SPEC(integer) SAMPLEID(integer)
  2. 
.                         tempvar touse
  3.                         gen byte `touse' = 1
  4.                         markout `touse' `outcome' origin_id languaged year
>  od_id `rhs'
  5. 
.                         quietly count if `touse'
  6.                         local raw_N = r(N)
  7.                         quietly summarize `outcome' if `touse'
  8.                         local projects = r(sum)
  9.                         quietly summarize n_people if `touse'
 10.                         local pop = r(sum)
 11. 
.                         frame post accounting (`sampleid') ("`table'") (`spec
> ') ///
>                                 (`raw_N') (`projects') (`pop') (e(N_full)) (e
> (N)) ///
>                                 (e(num_singletons)) (e(num_separated))
 12.                 end

. 
.         **Save one coefficient from the last model
. 
.                 capture program drop post_coef

.                 program define post_coef
  1.                         syntax , TERM(string) TABLE(string) SPEC(integer) 
> SPECLABEL(string) ///
>                                 SAMPLEID(integer) [POLICY(string)]
  2. 
.                         capture quietly lincom `term'
  3.                         if _rc exit
  4.                         frame post results (`sampleid') ("`table'") (`spec
> ') (`"`speclabel'"') ///
>                                 ("`policy'") (r(estimate)) (r(se)) (r(p))
  5.                 end

. 
.         **H0 (Tables 3, A13): local vs national diaspora, metro FE + state-ye
> ar FE
. 
.                 capture program drop run_h0

.                 program define run_h0
  1.                         syntax , OUTCOME(name) SAMPLEID(integer)
  2. 
.                         local spec = 0
  3.                         foreach x in ln_dias ln_total_indian_dias {
  4.                                 local ++spec
  5.                                 local lab "Subnational diaspora: exporter 
> FE + importer-year FE"
  6.                                 if "`x'" == "ln_total_indian_dias" local l
> ab "National Indian diaspora: exporter FE + importer-year FE"
  7. 
.                                 capture quietly ppmlhdfe `outcome' c.`x', ///
>                                         absorb(origin_id i.languaged#i.year) 
> vce(cluster od_id)
  8.                                 if _rc continue
  9.                                 post_accounting, outcome(`outcome') rhs(`x
> ') table(h0) spec(`spec') sampleid(`sampleid')
 10.                                 post_coef, term(`x') table(h0) spec(`spec'
> ) speclabel("`lab'") sampleid(`sampleid')
 11.                         }
 12.                 end

. 
.         **Diaspora-only models (Table A14), two sets of fixed effects
. 
.                 capture program drop run_table1

.                 program define run_table1
  1.                         syntax , OUTCOME(name) SAMPLEID(integer)
  2. 
.                         forvalues spec = 1/2 {
  3.                                 if `spec' == 1 {
  4.                                         local lab "PPML exporter-year FE +
>  importer-year FE"
  5.                                         local fe "i.origin_id#i.year i.lan
> guaged#i.year"
  6.                                 }
  7.                                 else {
  8.                                         local lab "PPML exporter FE + impo
> rter-year FE"
  9.                                         local fe "origin_id i.languaged#i.
> year"
 10.                                 }
 11. 
.                                 capture quietly ppmlhdfe `outcome' c.ln_dias,
>  absorb(`fe') vce(cluster od_id)
 12.                                 if _rc continue
 13.                                 post_accounting, outcome(`outcome') rhs(ln
> _dias) table(table1_baseline) spec(`spec') sampleid(`sampleid')
 14.                                 post_coef, term(ln_dias) table(table1_base
> line) spec(`spec') speclabel("`lab'") sampleid(`sampleid')
 15.                         }
 16.                 end

. 
.         **Tables 2-4 and single-policy tables: ln diaspora x policy
. 
.                 // Pair FE + metro-year FE + state-year FE, clustered by Indi
> an state.
.                 // The policy itself is absorbed by the state-year FE, so we 
> only report
.                 // the interaction.
.                 capture program drop run_interaction

.                 program define run_interaction
  1.                         syntax , OUTCOME(name) POLICY(name) TABLE(string) 
> SPEC(integer) ///
>                                 SPECLABEL(string) SAMPLEID(integer)
  2. 
.                         quietly summarize `policy'
  3.                         if missing(r(sd)) | r(sd) <= 0 exit             //
>  policy never varies here
  4. 
.                         capture quietly ppmlhdfe `outcome' c.ln_dias##c.`poli
> cy', ///
>                                 absorb(od_id i.origin_id#i.year i.languaged#i
> .year) vce(cluster languaged)
  5.                         if _rc exit
  6. 
.                         post_accounting, outcome(`outcome') rhs(ln_dias `poli
> cy') table(`table') ///
>                                 spec(`spec') sampleid(`sampleid')
  7.                         post_coef, term(c.ln_dias#c.`policy') table(`table
> ') spec(`spec') ///
>                                 speclabel(`"`speclabel'"') sampleid(`sampleid
> ') policy(`policy')
  8.                 end

. 
.         **Readable policy and category labels ("tax_regulatory_guidance" -> "
> Tax & Regulatory Guidance")
. 
.                 capture program drop make_label

.                 program define make_label, rclass
  1.                         args name
  2.                         local lab = proper(subinstr(subinstr("`name'", "to
> tal_", "", 1), "_", " ", .))
  3.                         local lab = subinstr("`lab'", "Tax Regulatory", "T
> ax & Regulatory", 1)
  4.                         local lab = subinstr("`lab'", "Bonds Financial", "
> Bonds & Financial", 1)
  5.                         local lab = subinstr("`lab'", "Religious Cultural"
> , "Religious & Cultural", 1)
  6.                         local lab = subinstr(subinstr("`lab'", "Nri ", "NR
> I ", .), " For ", " for ", .)
  7.                         return local label "`lab'"
  8.                 end

. 
.         **Run whichever tables a sample needs
. 
.                 capture program drop run_model

.                 program define run_model
  1.                         syntax , SAMPLEID(integer) FILE(string) OUTCOME(na
> me) ///
>                                 [H0 TABLE1 TABLE2 TABLE3 TABLE4 SINGLEPOLICY 
> TECHHUBS]
  2. 
.                         prep_panel, file(`file') `techhubs'
  3.                         di as text "Sample `sampleid': `file', `outcome'"
  4. 
.                         if "`h0'" != ""         run_h0, outcome(`outcome') sa
> mpleid(`sampleid')
  5.                         if "`table1'" != ""     run_table1, outcome(`outco
> me') sampleid(`sampleid')
  6. 
.                         if "`table2'" != "" {
  7.                                 run_interaction, outcome(`outcome') policy
> (any_dep) table(table2_h1) ///
>                                         spec(1) speclabel("Any DEP adoption")
>  sampleid(`sampleid')
  8.                         }
  9.                         if "`table3'" != "" {
 10.                                 run_interaction, outcome(`outcome') policy
> (sc_dep_count) table(table3_h2) ///
>                                         spec(1) speclabel("DEP count (support
> -screened)") sampleid(`sampleid')
 11.                         }
 12.                         if "`table4'" != "" {
 13.                                 local spec = 0
 14.                                 foreach c of global H4_CATEGORIES {
 15.                                         local ++spec
 16.                                         make_label `c'
 17.                                         local lab "`r(label)'"
 18.                                         run_interaction, outcome(`outcome'
> ) policy(sc_`c') table(table4_h3) ///
>                                                 spec(`spec') speclabel("`lab'
> ") sampleid(`sampleid')
 19.                                 }
 20.                         }
 21.                         if "`singlepolicy'" != "" {
 22.                                 local spec = 0
 23.                                 foreach p of global ALL_POLICIES {
 24.                                         local ++spec
 25.                                         make_label `p'
 26.                                         local lab "`r(label)'"
 27.                                         run_interaction, outcome(`outcome'
> ) policy(`p') table(singlepolicy) ///
>                                                 spec(`spec') speclabel("`lab'
> ") sampleid(`sampleid')
 28.                                 }
 29.                         }
 30.                 end

. 
