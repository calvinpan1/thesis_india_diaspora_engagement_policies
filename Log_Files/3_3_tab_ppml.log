.         **Columns that reuse a model above
. 
.                 // new column <- existing model
.                 foreach pair in "4 14" "21 11" "31 11" "53 22" "61 22" "71 22
> " "62 54" "72 63" "73 42" {
  2.                         gettoken new src : pair
  3.                         foreach f in results accounting {
  4.                                 frame `f' {
  5.                                         quietly expand 2 if sample_id == `
> src', generate(copy)
  6.                                         quietly replace sample_id = `new' 
> if copy
  7.                                         drop copy
  8.                                 }
  9.                         }
 10.                 }

. 
.         frame results: save "${gendata}/3_3_ppml_results.dta", replace
file
    /Users/calvin/wp_replication_package/Generated_Datasets/3_3_ppml_results.
    > dta saved

.         frame accounting: save "${gendata}/3_3_ppml_accounting.dta", replace
