. ********
. *
. *       6. Table 14: State-specific policy interactions
. *
. ********
. 
.         // Same interaction model, but the policy only "counts" in one state 
> at a
.         // time, to see whether a result is driven by a single state
. 
.         tempfile state_results

.         frame create statecut int col str40 policy str20 state double(coef_b 
> coef_se coef_p N_used)

.         local j = 0

.         foreach outcome in fdi_projects_all fdi_projects_ict {
  2.                 local ++j
  3.                 prep_panel, file(s1_firstgen_highed_25plus)
  4.                 quietly summarize `outcome'
  5.                 local projects`j' = string(r(sum), "%9.0f")
  6.                 quietly summarize n_people
  7.                 local pop`j' = string(r(sum), "%9.0f")
  8.                 local rawN`j' = string(r(N), "%9.0f")
  9. 
.                 foreach p in diaspora_admin_unit tax_regulatory_guidance dias
> pora_conferences {
 10.                         foreach st in "punjab" "tamil nadu" "kerala" "guja
> rat" {
 11.                                 capture drop p_state
 12.                                 gen double p_state = cond(indian_state == 
> "`st'", `p', 0)
 13.                                 quietly summarize p_state
 14.                                 if missing(r(sd)) | r(sd) <= 0 continue
 15. 
.                                 capture quietly ppmlhdfe `outcome' c.ln_dias#
> #c.p_state, ///
>                                         absorb(od_id i.origin_id#i.year i.lan
> guaged#i.year) vce(cluster languaged)
 16.                                 if _rc continue
 17.                                 local n_used = e(N)
 18.                                 capture quietly lincom c.ln_dias#c.p_state
 19.                                 if _rc continue
 20.                                 frame post statecut (`j') ("`p'") ("`st'")
>  (r(estimate)) (r(se)) (r(p)) (`n_used')
 21.                         }
 22.                 }
 23.         }
