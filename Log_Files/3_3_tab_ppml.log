    /Users/calvin/wp_replication_package/Generated_Datasets/3_3_ppml_accounti
    > ng.dta saved

. 
. ********
. *
. *       4. Programs that write the LaTeX tables
. *
. ********
. 
.         **Write a results table in the paper format
. 
.                 // columns() holds one sample ID per column, labels() the mat
> ching
.                 // column headers separated by "|". singlepolicy adds the # S
> tates and
.                 // # State-years columns and splits rows by how much support 
> a policy has.
.                 capture program drop write_table

.                 program define write_table
  1.                         syntax , TABLE(string) FILE(string) LABEL(string) 
> TITLE(string) ///
>                                 COLUMNS(numlist) LABELS(string) [SINGLEPOLICY
> ]
  2. 
.                         local ncols : word count `columns'
  3.                         local extra = cond("`singlepolicy'" != "", 2, 0)
  4.                         local totalcols = 1 + `extra' + `ncols'
  5. 
.                         **Coefficients, one row per spec with columns side by
>  side
. 
.                                 use "${gendata}/3_3_ppml_results.dta", clear
  6.                                 keep if table_id == "`table'"
  7.                                 gen col = .
  8.                                 local j = 0
  9.                                 foreach s of local columns {
 10.                                         local ++j
 11.                                         replace col = `j' if sample_id == 
> `s'
 12.                                 }
 13.                                 keep if !missing(col)
 14. 
.                                 gen stars = cond(coef_p < .01, "***", cond(co
> ef_p < .05, "**", cond(coef_p < .10, "*", "")))
 15.                                 gen coef = string(round(coef_b, .001), "%9
> .3f") + stars
 16.                                 gen se = "(" + string(round(coef_se, .001)
> , "%9.3f") + ")"
 17.                                 // ppmlhdfe omits a term it can't identify
> ; show it as a dash, not 0.000
.                                 replace coef = "---" if coef_se < 1e-5 | miss
> ing(coef_se)
 18.                                 replace se = "" if coef_se < 1e-5 | missin
> g(coef_se)
 19. 
.                                 // Single-policy tables only show policies in
>  2+ states and more
.                                 // than 10 state-years, split into two panels
>  by support
.                                 gen byte panel = 1
 20.                                 if "`singlepolicy'" != "" {
 21.                                         merge m:1 policy using "${gendata}
> /3_3_policy_support.dta", ///
>                                                 keepusing(support_states supp
> ort_obs) keep(match) nogen
 22.                                         keep if support_states >= 2 & supp
> ort_obs > 10
 23.                                         replace panel = cond(support_state
> s >= 3 & support_obs >= 20, 1, 2)
 24.                                 }
 25.                                 else {
 26.                                         gen support_states = .
 27.                                         gen support_obs = .
 28.                                 }
 29. 
.                                 keep spec_order spec_label panel support_stat
> es support_obs col coef se
 30.                                 reshape wide coef se, i(spec_order) j(col)
 31.                                 forvalues j = 1/`ncols' {
 32.                                         capture gen coef`j' = ""
 33.                                         capture gen se`j' = ""
 34.                                 }
 35.                                 sort panel spec_order
 36.                                 replace spec_label = subinstr(subinstr(spe
> c_label, "_", "\_", .), "&", "\&", .)
 37. 
.                                 tempfile rows
 38.                                 save `rows'
 39. 
.                         **Sample-size footer (shows a range when it varies ac
> ross specs)
. 
.                                 use "${gendata}/3_3_ppml_accounting.dta", cle
> ar
 40.                                 keep if table_id == "`table'"
 41.                                 collapse (min) raw_N_lo = raw_N projects_l
> o = projects pop_lo = pop ///
>                                                 N_full_lo = N_full N_used_lo 
> = N_used singletons_lo = singletons separated_lo = separated ///
>                                         (max) raw_N_hi = raw_N projects_hi = 
> projects pop_hi = pop ///
>                                                 N_full_hi = N_full N_used_hi 
> = N_used singletons_hi = singletons separated_hi = separated, ///
>                                         by(sample_id)
 42.                                 foreach m in raw_N projects pop N_full N_u
> sed singletons separated {
 43.                                         gen `m' = string(`m'_lo, "%9.0f") 
> if `m'_lo < .
 44.                                         replace `m' = `m' + "-" + string(`
> m'_hi, "%9.0f") if `m'_lo != `m'_hi & `m'_hi < .
 45.                                 }
 46.                                 local j = 0
 47.                                 foreach s of local columns {
 48.                                         local ++j
 49.                                         foreach m in raw_N projects pop N_
> full N_used singletons separated {
 50.                                                 quietly levelsof `m' if sa
> mple_id == `s', local(`m'`j') clean
 51.                                         }
 52.                                 }
 53. 
.                         **Write the file
. 
.                                 use `rows', clear
 54.                                 // Wide tables (8+ columns) get smaller te
> xt and tighter spacing
.                                 local size = cond(`totalcols' >= 8, "\scripts
> ize", "\footnotesize")
 55.                                 local sep = cond(`totalcols' >= 8, "2pt", 
> "3pt")
 56.                                 local fullwidth "@{}>{\RaggedRight\arrayba
> ckslash}p{\dimexpr\linewidth-2\tabcolsep\relax}@{}"
 57.                                 local blank = cond("`singlepolicy'" != "",
>  " &  & ", "")
 58. 
.                                 file open tab using "${tables}/`file'", write
>  replace text
 59.                                 file write tab "\begin{table}[!htbp]" _n
 60.                                 file write tab "\centering" _n
 61.                                 file write tab "`size'" _n
 62.                                 file write tab "\setlength{\tabcolsep}{`se
> p'}" _n
 63.                                 file write tab "\renewcommand{\arraystretc
> h}{1.08}" _n
 64.                                 file write tab "\caption{`title'}" _n
 65.                                 file write tab "\label{tab:`label'}" _n
 66.                                 file write tab "\begin{tabularx}{\textwidt
> h}{@{}>{\RaggedRight\arraybackslash}X *{`=`totalcols'-1'}{>{\Centering\arrayb
> ackslash}X}@{}}" _n
 67.                                 file write tab "\hline" _n
 68. 
.                                 // Header row
.                                 file write tab "Specification"
 69.                                 if "`singlepolicy'" != "" file write tab "
>  & \# States & \# State-years"
 70.                                 local rest `"`labels'"'
 71.                                 forvalues j = 1/`ncols' {
 72.                                         gettoken lab rest : rest, parse("|
> ")
 73.                                         if "`lab'" == "|" gettoken lab res
> t : rest, parse("|")
 74.                                         file write tab " & " (subinstr(tri
> m("`lab'"), "&", "\&", .))
 75.                                 }
 76.                                 file write tab " \\" _n
 77.                                 file write tab "\hline" _n
 78. 
.                                 // Coefficient rows, with standard errors und
> erneath
.                                 forvalues i = 1/`=_N' {
 79.                                         if "`singlepolicy'" != "" & (`i' =
> = 1 | panel[`i'] != panel[max(`i'-1, 1)]) {
 80.                                                 local heading = cond(panel
> [`i'] == 1, "Policies with 3+ states and 20+ state-years", ///
>                                                         "Policies with 2+ sta
> tes and more than 10 state-years")
 81.                                                 file write tab "\multicolu
> mn{`totalcols'}{`fullwidth'}{\textit{`heading'}}\\" _n
 82.                                         }
 83.                                         file write tab (spec_label[`i'])
 84.                                         if "`singlepolicy'" != "" {
 85.                                                 file write tab " & " (stri
> ng(support_states[`i'], "%9.0f")) " & " (string(support_obs[`i'], "%9.0f"))
 86.                                         }
 87.                                         forvalues j = 1/`ncols' {
 88.                                                 file write tab " & " (coef
> `j'[`i'])
 89.                                         }
 90.                                         file write tab " \\" _n
 91.                                         file write tab "`blank'"
 92.                                         forvalues j = 1/`ncols' {
 93.                                                 file write tab " & " (se`j
> '[`i'])
 94.                                         }
 95.                                         file write tab " \\" _n
 96.                                 }
 97.                                 file write tab "\hline" _n
 98. 
.                                 // Footer
.                                 local f_raw_N           "Raw sample N"
 99.                                 local f_projects        "Projects, 2005--2
> 017"
100.                                 local f_pop                     "Total dia
> spora pop., 2005--2017"
101.                                 local f_N_full          "e(N\_full)"
102.                                 local f_N_used          "e(N)"
103.                                 local f_singletons      "Dropped singleton
> s"
104.                                 local f_separated       "Dropped separated
>  obs"
105.                                 foreach m in raw_N projects pop N_full N_u
> sed singletons separated {
106.                                         file write tab "`f_`m''`blank'"
107.                                         forvalues j = 1/`ncols' {
108.                                                 file write tab " & ``m'`j'
> '"
109.                                         }
110.                                         file write tab " \\" _n
111.                                 }
112.                                 file write tab "\hline" _n
113.                                 if inlist("`table'", "h0", "table1_baselin
> e") {
114.                                         local note "Cells are coefficients
>  on ln\_dias (or the national Indian diaspora), with SEs clustered by metro-s
> tate pair directly underneath. Fixed effects as listed in each row."
115.                                 }
116.                                 else {
117.                                         local note "Cells are coefficients
>  on ln\_dias x policy, with SEs clustered by Indian state directly underneath
> . All models include metro-state, metro-year, and state-year fixed effects. -
> -- marks an interaction ppmlhdfe omits because it is not identified once sing
> letons and separated observations are dropped."
118.                                 }
119.                                 file write tab "\fulltablenote{`totalcols'
> }{`note'}" _n
120.                                 file write tab "\fulltablenote{`totalcols'
> }{* p<0.10, ** p<0.05, *** p<0.01.}" _n
121.                                 file write tab "\end{tabularx}" _n
122.                                 file write tab "\end{table}" _n
123.                                 file close tab
124.                 end

