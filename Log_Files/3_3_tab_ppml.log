. ********
. *
. *       1. Which policies have enough support to estimate
. *
. ********
. 
.         // A policy is "supported" if at least 2 states have it, for at least
>  10
.         // state-years in 2005-2017. Rarer policies are basically case studie
> s, so
.         // Tables 3 and 4 only count supported ones. The single-policy tables
>  show
.         // policies in 2+ states and MORE than 10 state-years.
. 
.         use "${gendata}/2_3_dep_turnons_long.dta", clear

.         keep if item_type == "policy" & inrange(year, 2005, 2017)
(6,184 observations deleted)

. 
.         gen byte has_it = value > 0

.         bysort item indian_state: gen byte state_has_it = has_it & sum(has_it
> ) == 1

.         collapse (sum) support_obs = has_it support_states = state_has_it ///
>                 (first) category item_order, by(item)

. 
.         gen byte eligible = support_states >= 2 & support_obs >= 10

.         sort item_order

. 
.         **Origin ID for non-citizens (see note)
. 
.                 // The thesis tables were run without this policy: the origin
> al code
.                 // renamed it in one place but not another, so it silently dr
> opped out
.                 // of the DEP counts, the State Bureaucracy category, and the
.                 // single-policy tables. Left out here so the tables match th
> e thesis and paper.
.                 // Set include_origin_id to 1 in 0_master.do to put it back.
.                 if "${include_origin_id}" != "1" drop if item == "origin_id_n
> on_citizens"
(1 observation deleted)

. 
.         **Lists used by the models below
. 
.                 levelsof item if eligible, local(eligible) clean
diaspora_admin_unit diaspora_conferences grievance_reporting investment_promoti
> on_roadshows manpower_companies remains_repatriation tax_regulatory_guidance

.                 global ELIGIBLE_POLICIES "`eligible'"

. 
.                 // Every policy in DEP-data order (for the single-policy tabl
> es)
.                 global ALL_POLICIES ""

.                 forvalues i = 1/`=_N' {
  2.                         global ALL_POLICIES "${ALL_POLICIES} `=item[`i']'"
  3.                 }

. 
.                 // Table 4 categories: any category with at least one support
> ed policy,
.                 // in DEP-data order. The category measure only counts suppor
> ted ones.
.                 global H4_CATEGORIES ""

.                 levelsof category if eligible, local(cats) clean
total_abroad total_info total_state_bureaucracy total_symbolic

.                 foreach c in total_symbolic total_religious_cultural total_ci
> tizenship ///
>                         total_state_bureaucracy total_abroad total_networks t
> otal_info total_advantages {
  2.                         if strpos(" `cats' ", " `c' ") == 0 continue
  3.                         global H4_CATEGORIES "${H4_CATEGORIES} `c'"
  4.                         levelsof item if eligible & category == "`c'", loc
> al(members) clean
  5.                         global MEMBERS_`c' "`members'"
  6.                 }
diaspora_conferences
diaspora_admin_unit grievance_reporting
manpower_companies remains_repatriation
investment_promotion_roadshows tax_regulatory_guidance

. 
.         di as text "Supported policies: ${ELIGIBLE_POLICIES}"
Supported policies: diaspora_admin_unit diaspora_conferences grievance_reportin
> g investment_promotion_roadshows manpower_companies remains_repatriation tax_
> regulatory_guidance

.         di as text "Table 4 categories: ${H4_CATEGORIES}"
Table 4 categories:  total_symbolic total_state_bureaucracy total_abroad total_
> info

. 
