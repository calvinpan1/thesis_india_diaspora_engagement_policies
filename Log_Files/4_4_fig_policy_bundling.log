. *
. *       2. Program for adoption-timing dot plots
. *
. ********
. 
.         // One row per state, a dot at the year it first adopted the policy.
.         // Expects indian_state and first_year. "Never", "Pre-2005" and
.         // "Post-2017" get their own spots on the axis unless ADMINUNIT is se
> t.
. 
.         capture program drop timing_plot

.         program define timing_plot
  1.                 syntax , TITLE(string) NAME(name) [ADMINUNIT]
  2. 
.                 gen yorder = .
  3.                 local i = 0
  4.                 foreach s in "karnataka" "kerala" "maharashtra" "west beng
> al" ///
>                         "andhra pradesh" "gujarat" "punjab" "tamil nadu" {
  5.                         local ++i
  6.                         replace yorder = `i' if indian_state == "`s'"
  7.                 }
  8.                 local ylab `"1 "Karnataka" 2 "Kerala" 3 "Maharashtra" 4 "W
> est Bengal" 5 "Andhra Pradesh" 6 "Gujarat" 7 "Punjab" 8 "Tamil Nadu""'
  9. 
.                 if "`adminunit'" != "" {
 10.                         gen plot_year = cond(missing(first_year), 1994, fi
> rst_year)
 11.                         twoway ///
>                                 (scatter yorder plot_year if !missing(first_y
> ear), msymbol(O) msize(medlarge) mcolor(green) mfcolor(green)) ///
>                                 (scatter yorder plot_year if missing(first_ye
> ar), msymbol(X) msize(medlarge) mcolor(red)), ///
>                                 xline(2005, lpattern(solid) lcolor(blue)) ///
>                                 xline(2017, lpattern(solid) lcolor(blue)) ///
>                                 xscale(range(1994 2025)) ///
>                                 xlabel(1994 "Never" 1995(5)2025, angle(35) la
> bsize(vsmall)) ///
>                                 yscale(range(0.5 8.5)) ///
>                                 ylabel(`ylab', angle(0) noticks labsize(small
> )) ///
>                                 xtitle("") ytitle("") ///
>                                 title("`title'", size(small)) ///
>                                 legend(off) ///
>                                 graphregion(color(white)) plotregion(margin(s
> mall)) ///
>                                 xsize(8.2) ysize(4.2) name(`name', replace)
 12.                 }
 13.                 else {
 14.                         // Filled dot = adopted 2005-2017, open dot = outs
> ide the sample years
.                         gen byte inside = inrange(first_year, 2005, 2017)
 15.                         gen plot_year = first_year
 16.                         replace plot_year = 2003 if missing(first_year)
 17.                         replace plot_year = 2004 if first_year < 2005
 18.                         replace plot_year = 2018 if first_year > 2017 & !m
> issing(first_year)
 19.                         twoway ///
>                                 (scatter yorder plot_year if inside, msymbol(
> O) msize(medlarge) mcolor(green) mfcolor(green)) ///
>                                 (scatter yorder plot_year if !inside & !missi
> ng(first_year), msymbol(Oh) msize(medlarge) mcolor(green) mfcolor(none)) ///
>                                 (scatter yorder plot_year if missing(first_ye
> ar), msymbol(X) msize(medlarge) mcolor(red)), ///
>                                 xline(2005, lpattern(dash) lcolor(gs12)) ///
>                                 xline(2017, lpattern(dash) lcolor(gs12)) ///
>                                 xscale(range(2003 2018)) ///
>                                 xlabel(2003 "Never" 2004 "Pre-2005" 2005(5)20
> 15 2017 "2017" 2018 "Post-2017", angle(35) labsize(vsmall)) ///
>                                 yscale(range(0.5 8.5)) ///
>                                 ylabel(`ylab', angle(0) noticks labsize(small
> )) ///
>                                 xtitle("") ytitle("") ///
>                                 title("`title'", size(small)) ///
>                                 legend(off) ///
>                                 graphregion(color(white)) plotregion(margin(s
> mall)) ///
>                                 xsize(7.5) ysize(4.2) name(`name', replace)
 20.                 }
 21.         end

