. ********
. *
. *       1. Program that draws one line per state
. *
. ********
. 
.         // Expects data with indian_state ("Andhra Pradesh", ...), year, and 
> the
.         // variable to plot. Three styles:
.         //      allstates:      adds an "All states" total line (Fig 5.7)
.         //      allindia:       adds an all-India total, split at 2014 when A
> ndhra Pradesh
.         //                              drops out so the line doesn't fake a 
> drop (Figs 5.2, 5.6)
.         //      statesonly:     just the 8 states (Figs 5.3-5.5, 5.9-5.11)
. 
.         capture program drop plot_by_state

.         program define plot_by_state
  1.                 syntax , VAR(name) TITLE(string) YTITLE(string) FILE(strin
> g) STYLE(string) ///
>                         [AUTOXLABEL]
  2. 
.                 // Default ticks every other year, or let Stata pick (Fig 5.1
> 1)
.                 local xlabel "2005(2)2017"
  3.                 if "`autoxlabel'" != "" local xlabel ""
  4.                 local states `""Andhra Pradesh" "Gujarat" "Karnataka" "Ker
> ala" "Maharashtra" "Punjab" "Tamil Nadu" "West Bengal""'
  5. 
.                 preserve
  6.                         **Extra total lines
. 
.                                 if "`style'" == "allstates" {
  7.                                         tempfile total
  8.                                         collapse (sum) `var', by(year)
  9.                                         gen indian_state = "All states"
 10.                                         save `total'
 11.                                         restore, preserve
 12.                                         append using `total'
 13.                                         local extra `""All states""'
 14.                                 }
 15.                                 if "`style'" == "allindia" {
 16.                                         tempfile pre post
 17.                                         collapse (sum) `var', by(year)
 18.                                         gen indian_state = "All India obse
> rvations (through 2013)"
 19.                                         replace `var' = . if year > 2013
 20.                                         save `pre'
 21.                                         restore, preserve
 22.                                         collapse (sum) `var', by(year)
 23.                                         gen indian_state = "All India obse
> rvations (2015-2017)"
 24.                                         replace `var' = . if year < 2015
 25.                                         save `post'
 26.                                         restore, preserve
 27.                                         append using `pre' `post'
 28.                                         local extra `""All India observati
> ons (through 2013)" "All India observations (2015-2017)""'
 29.                                 }
 30. 
.                         **One line per group, legend in the same order
. 
.                                 local lines ""
 31.                                 local legend ""
 32.                                 local i = 0
 33.                                 foreach s in `extra' `states' {
 34.                                         local ++i
 35.                                         local lines `"`lines' (line `var' 
> year if indian_state == "`s'", sort)"'
 36.                                         local legend `"`legend' `i' "`s'""
> '
 37.                                 }
 38. 
.                                 local cols = cond("`style'" == "statesonly", 
> 4, 3)
 39.                                 local legsize = cond("`style'" == "allindi
> a", "8pt", "9pt")
 40. 
.                                 graph twoway `lines', ///
>                                         title("`title'", size(12pt)) ///
>                                         ytitle("`ytitle'", size(12pt)) ///
>                                         xtitle("Year", size(12pt)) ///
>                                         xlabel(`xlabel', labsize(10pt)) ///
>                                         ylabel(, labsize(10pt) angle(horizont
> al)) ///
>                                         legend(order(`legend') position(6) ri
> ng(1) cols(`cols') size(`legsize') region(lstyle(none))) ///
>                                         graphregion(color(white))
 41.                                 graph export "${figures}/`file'", replace
 42.                 restore
 43.         end

