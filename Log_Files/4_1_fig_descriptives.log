. 
.         **Program: diaspora count by state-year for one definition of diaspor
> a
. 
.                 capture program drop diaspora_by_state

.                 program define diaspora_by_state
  1.                         syntax , KEEPIF(string)
  2. 
.                         use "${gendata}/1_1_acs_india_microdata.dta", clear
  3.                         merge m:1 met2013 using "${gendata}/2_1_top50_metr
> os.dta", keep(match) nogen
  4.                         keep if `keepif'
  5.                         drop if languaged == 4003 & inrange(year, 2014, 20
> 17)
  6.                         collapse (sum) n_people = perwt, by(year languaged
> )
  7. 
.                         gen indian_state = ""
  8.                         replace indian_state = "Kerala"                 if
>  languaged == 4004
  9.                         replace indian_state = "Tamil Nadu"             if
>  languaged == 4005
 10.                         replace indian_state = "Gujarat"                if
>  languaged == 3115
 11.                         replace indian_state = "Karnataka"              if
>  languaged == 3130
 12.                         replace indian_state = "Maharashtra"    if languag
> ed == 3114
 13.                         replace indian_state = "Punjab"                 if
>  languaged == 3113
 14.                         replace indian_state = "Andhra Pradesh" if languag
> ed == 4003
 15.                         replace indian_state = "West Bengal"    if languag
> ed == 3112
 16.                         drop languaged
 17. 
.                         // Every state-year shows up, with 0 if nobody's ther
> e
.                         fillin indian_state year
 18.                         replace n_people = 0 if missing(n_people)
 19.                         replace n_people = . if indian_state == "Andhra Pr
> adesh" & year >= 2014
 20.                 end

