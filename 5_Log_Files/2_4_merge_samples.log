. ********
. *
. *       1. FDI counts as a Stata file
. *
. ********
. 
.         import delimited using "${rawdata}/fdi_extracts/2_2_fdi_counts_metro_
> language_year.csv", ///
>                 clear varnames(1)
(encoding automatically selected: ISO-8859-1)
(20 vars, 1,130 obs)

.         tempfile fdi

.         save `fdi'
file /var/folders/_0/c6pysbl159gbzd5zt3xp1rnr0000gp/T//St85947.000001 saved
    as .dta format

. 
. ********
. *
. *       2. Merge each sample
. *
. ********
. 
.         local samples s1_firstgen_highed s3_firstgen_all s4_allgen_all ///
>                 s1_firstgen_highed_25plus s3_firstgen_all_25plus s4_allgen_al
> l_25plus ///
>                 s24_allgen_highed_25plus s25_firstgen_all_ict_25plus s27_firs
> tgen_highed_ict_25plus ///
>                 s28_allgen_highed_ict_25plus

. 
.         foreach s of local samples {
  2. 
.                 use "${gendata}/2_1_`s'.dta", clear
  3.                 keep if metro_rank <= 50        // each language's top 50 
> US metros
  4. 
.                 **FDI projects from that metro to that language's home state
. 
.                         merge m:1 year met2013 languaged using `fdi', keep(ma
> ster match) nogen
  5.                         foreach v of varlist fdi_projects_* {
  6.                                 replace `v' = 0 if missing(`v')         //
>  no row means no projects
  7.                         }
  8. 
.                 **DEPs in the home state that year
. 
.                         gen indian_state = ""
  9.                         replace indian_state = "kerala"                 if
>  languaged == 4004
 10.                         replace indian_state = "tamil nadu"             if
>  languaged == 4005
 11.                         replace indian_state = "gujarat"                if
>  languaged == 3115
 12.                         replace indian_state = "karnataka"              if
>  languaged == 3130
 13.                         replace indian_state = "maharashtra"    if languag
> ed == 3114
 14.                         replace indian_state = "punjab"                 if
>  languaged == 3113
 15.                         replace indian_state = "andhra pradesh" if languag
> ed == 4003
 16.                         replace indian_state = "west bengal"    if languag
> ed == 3112
 17. 
.                         merge m:1 indian_state year using "${gendata}/2_3_dep
> s_state_year.dta", ///
>                                 keep(master match) nogen
 18. 
.                 // Row order doesn't change the math, but a few thin-data PPM
> L models
.                 // that never really converge (e.g. Life Sciences FDI) give d
> ifferent
.                 // numbers if it changes. Sorting on a unique key keeps every
>  run identical.
.                 sort languaged met2013 year state
 19.                 compress
 20.                 save "${gendata}/2_4_`s'.dta", replace
 21. 
.                 di as text "`s': " _N " metro x state x year rows"
 22.         }
