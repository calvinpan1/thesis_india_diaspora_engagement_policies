.         **Reshape long, keeping column order and each policy's category
. 
.                 ds indian_state year, not
total_deps    heritage_t~s  extensive_~s  total_netw~s  entreprene~t
total_non_~n  schools_ab~d  grievance_~g  scientific~s  total_adva~s
total_symb~c  total_citi~p  total_abroad  business_n~s  tax_advant~s
diaspora_day  special_le~i  remains_re~n  temporary_~s  loan_advan~s
expat_awards  expatriate~s  health_ser~d  innovation~s  matching_f~s
diaspora_c~s  total_stat~y  other_welf~d  total_info    diaspora_b~t
diaspora_a~n  origin_id_~s  other_pred~t  tax_regula~e  fee_waivers
media_cove~d  nri_courts    welfare_fo~s  project_ma~m  credit_gua~s
total_reli~l  nri_police    manpower_c~s  investment~s  preferenti~n
religious_~d  improved_s~s  remittance~n  single_win~n  expedited_~s
cultural_c~d  diaspora_a~t  total_econ    aftercare_~s  sectoral_r~s

.                 local depvars `r(varlist)'

.                 local order = 0

.                 local category ""

.                 tempfile long

.                 foreach v of local depvars {
  2.                         local ++order
  3.                         if "`v'" == "total_deps" continue
  4. 
.                         // Broad totals (non-econ, econ) reset the category, 
> other totals
.                         // start a new one, and everything else is a policy i
> n that category
.                         local type "policy"
  5.                         if inlist("`v'", "total_non_econ", "total_econ") {
  6.                                 local type "broad_total"
  7.                                 local category ""
  8.                         }
  9.                         else if substr("`v'", 1, 6) == "total_" {
 10.                                 local type "category_total"
 11.                                 local category "`v'"
 12.                         }
 13. 
.                         preserve
 14.                                 keep indian_state year `v'
 15.                                 rename `v' value
 16.                                 gen item = "`v'"
 17.                                 gen item_type = "`type'"
 18.                                 gen category = "`category'"
 19.                                 gen item_order = `order'
 20.                                 capture append using `long'
 21.                                 save `long', replace
 22.                         restore
 23.                 }
